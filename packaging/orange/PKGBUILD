# The front end of GLaDOS's package manager: apt-style verbs over pacman.
pkgname=orange
pkgver=1.3
pkgrel=1
pkgdesc="The package manager of GLaDOS: apt-style verbs and pacman flags over pacman"
arch=('any')
url="https://github.com/IlumCI/GLaDOS"
license=('custom')  # the project has no licence file yet
depends=('pacman' 'bash' 'python' 'util-linux' 'libarchive')
source=('orange' 'aur.py' 'deb.py' 'fakeroot')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "$srcdir/orange" "$pkgdir/usr/bin/orange"
    install -Dm755 "$srcdir/aur.py" "$pkgdir/usr/lib/orange/aur.py"
    install -Dm755 "$srcdir/deb.py" "$pkgdir/usr/lib/orange/deb.py"
    # Outside PATH on purpose: put in front of it only for orange's builds.
    install -Dm755 "$srcdir/fakeroot" "$pkgdir/usr/lib/orange/shim/fakeroot"
}

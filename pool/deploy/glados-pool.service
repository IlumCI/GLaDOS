[Unit]
# The pool daemon, as a systemd service.
#
# Written to be a polite guest before it is a fast one. This runs on a machine
# somebody lent us, so every limit below is set to a measured figure with
# headroom rather than left open -- a mining pool that took a friend's server
# down would be a worse outcome than one that refused a share.
Description=GLaDOS multi-coin mining pool
Documentation=https://github.com/IlumCI/GLaDOS/blob/main/design/pool.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=glados-pool
Group=glados-pool

# The share target is the knob that decides load: the pool hashes once per
# share, so what costs CPU is how often shares arrive and not how fast anybody
# mines. See `glados-pool --bench` and design/pool.md. Twelve bits suits a
# laptop on yespower; sha256d and blake2s are thousands of times cheaper to
# check and can afford a much harder target.
# **`run-pool.sh` is the source of truth for this argv and this file drifted
# from it.** Everything below but `--listen` and `--ledger` was missing, and the
# absence that mattered was `--window`: without it the pool falls back to
# `DEFAULT_WINDOW_WORK`, which `design/live36.md` measures at **five seconds of
# mining** at twenty bits and 256 miners, and calls the one thing that has to
# change before an event. PPLNS pays the last N units of work, so everybody who
# mined for thirty-six hours and stopped six seconds before a block got nothing.
# That value shipped in this file the whole time.
#
# The settings and where each comes from:
#
#     --window 70368744177664   2^46, about 0.80 of a Bitzeny block. Chosen for
#                               bitzeny and meaningless against testnet, whose
#                               difficulty swings under the 20-minute rule; the
#                               payout line prints what it is worth on each.
#                               **For a bounded event, pay from the tally
#                               instead** -- `distribute.py --basis tally` does
#                               not read this at all, and `design/runbook.md`
#                               step 5 says tally is the answer for an event.
#     --cpu-percent 25          the total validation budget as a share of one
#                               core, which is what bounds a flood: the
#                               per-connection limit never summed.
#     --share-seconds 45        makes yespower affordable at that budget
#     --max-connections 900     measured at 850: 852 threads, 21 MB, load 1.25
#     --roster / --roster-url   answer "can this name be paid" at the greeting
#
# **`--require-roster` is absent deliberately.** It refuses an unregistered name
# at the greeting, which is a statement that a roster exists, and
# `supabase/functions/worker` has to be deployed and answering first. The pool
# fails *open* on an unreadable roster either way and says so at startup.
#
# **And nothing here refreshes the roster.** `run-pool.sh` carries a background
# loop for it because the host it was deployed to has neither cron nor
# lingering; under systemd the answer is a user timer, which needs the user
# manager that lingering keeps alive. So on a box where these units can run at
# all, add the timer -- and on one where they cannot, use the script.
#
# **No upstream.** A coin spec grows `@host:port,user,pass`, and at zpool -- the
# wallet-as-username auto-exchange pool `design/mining.md` item 8 says to point
# at, and the only anonymous one of its kind still operating -- the username *is*
# the payout address, so a placeholder left here mines to whoever owns it. Not
# a solo pool and not sha256d: yespower is where this machine's CPU is a real
# participant. See `run-pool.sh` for the form and the reason it is empty.
ExecStart=/usr/local/bin/glados-pool \
    --listen 0.0.0.0:3334 \
    --ledger /var/lib/glados-pool/ledger.json \
    --roster /var/lib/glados-pool/roster.json \
    --roster-url https://glados.aperture.institute/pool/ \
    --cpu-percent 25 \
    --share-seconds 45 \
    --max-connections 900 \
    --window 70368744177664 \
    bitzeny:yespower-10-2048-8:12 \
    testnet:sha256d:24

Restart=always
RestartSec=5s

# --- limits, all against measured numbers ---
#
# Measured: 3.49 MB resident with four coins, plus at most one algorithm
# working set live at a time -- 8,296 KiB at the largest yespower setting.
# `Pool` is behind a mutex and validation happens while it is held, so shares
# are checked one at a time and the peak is one working set rather than one per
# miner. Call it 12 MB in the worst case; 64 M is five times that.
#
# If this ever OOMs, the thing to look at first is whether somebody made
# validation parallel, because that is the one change that turns peak memory
# into `threads * 8 MiB`.
MemoryMax=64M
MemoryHigh=48M

# Half a core. Measured, one whole core absorbs 133 yespower-8MiB validations a
# second and a laptop-class miner submits about 0.1 -- so half a core is still
# several hundred miners, and leaving the other half to the machine's owner
# costs nothing anybody will notice.
CPUQuota=50%

# A thread per connection, so this is the connection ceiling in disguise. Raise
# it and MemoryMax together if the pool ever has that many miners.
TasksMax=512

# **Descriptors, which this unit did not raise and the script does.** Every
# connection is one and the login default is 1024, so the ceiling could not
# usefully pass about a thousand however `--max-connections` was set -- a limit
# that reads as absent rather than as wrong. The hard limit is 524288 and
# raising the soft limit needs no privilege, which is why `run-pool.sh` does it
# with a plain `ulimit`. The daemon reads the real limit and clamps its own
# ceiling to it, so getting this wrong is a smaller pool and not a failure.
LimitNOFILE=65536

# --- hardening ---
#
# The daemon needs a listening socket above 1024, one directory to write, and
# nothing else at all. Everything below is that stated as policy.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# The one writable path. The ledger is the whole product of a non-custodial
# pool, so it needs somewhere to live that survives a restart -- even though
# nothing reads it back yet.
StateDirectory=glados-pool
ReadWritePaths=/var/lib/glados-pool

# Port 3334 is above 1024, so no capability is needed to bind it. Stated
# because the obvious instinct is to give this CAP_NET_BIND_SERVICE and it
# genuinely does not want it.
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target

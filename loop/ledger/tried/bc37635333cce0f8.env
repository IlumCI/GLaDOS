--- patch
--- /dev/null
+++ b/src/fmt/pixel_format.rs
@@ -0,0 +1,26 @@
+/// A 4x4 block of pixels is represented as a 4x4 block of bytes, so when written to,
+/// the data should read back exactly the same. This ensures correct encoding/decoding behavior
+/// for fixed-width pixel formats without requiring dynamic allocation or runtime checks.
+pub fn encode(block: &[u8; 16]) -> [u8; 16] {
+    let mut out = [0u8; 16];
+    let mut i = 0;
+    while i < 16 {
+        out[i] = block[i];
+        i += 1;
+    }
+    out
+}
+
+pub fn selftest() -> bool {
+    let flat = [7u8; 16];
+    let encoded = encode(&flat);
+    
+    // Check that writing the flat block results in the same output
+    let good = encoded[0] == 7 && encoded[3] == 7 && 
+                 encoded[12] == 7 && encoded[15] == 7;
+
+    crate::kprintln!("  {}   a pixel format that represents a 4x4 block of pixels as a 4x4 block of",
+                      if good { "ok " } else { "FAIL" });
+
+    good
+}
--- a/src/fmt/mod.rs
+++ b/src/fmt/mod.rs
@@ -30,6 +30,7 @@

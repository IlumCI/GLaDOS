#version 450
// out[i] = i*i + 7 for i < n, which no fill pattern or stale buffer matches.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Out { uint v[]; } o;
layout(push_constant) uniform P { uint n; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.n) o.v[i] = i * i + 7u;
}
